#!/usr/bin/env python3
"""Maintain only the dedicated TCP/UDP port 47800 policy."""
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys

TABLE='tokervpn_port_47800'
EXPECTED=Path('/etc/tokervpn-port-47800/expected.json')
LOCK=Path('/run/tokervpn-port-47800.lock')
RULES='table inet '+TABLE+' {\n'
for hook in ['input','output','forward']:
 RULES+=' chain '+hook+' {\n  type filter hook '+hook+' priority -12; policy accept;\n'
 RULES+='  ct direction original tcp dport 47800 counter reject with tcp reset\n'
 RULES+='  ct direction original udp dport 47800 counter reject with icmpx type admin-prohibited\n }\n'
 if hook in ['output','forward']:
  RULES=RULES[:-3]+'  ct direction original tcp sport 47800 counter reject with tcp reset\n  ct direction original udp sport 47800 counter reject with icmpx type admin-prohibited\n }\n'
RULES+='}\n'
RESERVED=Path('/proc/sys/net/ipv4/ip_local_reserved_ports')

def reserved_contains(value):
 for item in value.strip().split(','):
  if not item:continue
  parts=item.split('-');low=int(parts[0]);high=int(parts[-1]);assert 0<=low<=high<=65535
  if low<=47800<=high:return True
 return False

def ensure_reserved(check=False):
 before=RESERVED.read_text().strip()
 if reserved_contains(before):return False
 if check:raise RuntimeError('Port 47800 is not reserved from automatic source-port selection')
 RESERVED.write_text(before+(',' if before else '')+'47800\n')
 assert reserved_contains(RESERVED.read_text())
 return True

def run(args,**kw):
 return subprocess.run(args,capture_output=True,text=True,timeout=15,**kw)

def clean(value):
 if isinstance(value,dict):
  return {k:(None if k=='counter' else clean(v)) for k,v in value.items() if k not in ['handle','position','index','use','packets','bytes']}
 if isinstance(value,list):return [clean(x) for x in value]
 return value

def current():
 p=run(['nft','-j','list','table','inet',TABLE])
 if p.returncode:return None
 return clean([x for x in json.loads(p.stdout)['nftables'] if 'metainfo' not in x])

def main():
 os.umask(0o077)
 EXPECTED.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
 with LOCK.open('w') as lock:
  fcntl.flock(lock,fcntl.LOCK_EX)
  before=current()
  expected=json.loads(EXPECTED.read_text()) if EXPECTED.exists() else None
  if before is not None and before==expected:
   changed=ensure_reserved('--check' in sys.argv)
   print('VERIFIED port=47800 tcp=blocked udp=blocked changed='+str(int(changed)));return
  if '--check' in sys.argv:raise RuntimeError('Dedicated port 47800 policy is absent or differs')
  payload=('delete table inet '+TABLE+'\n' if before is not None else '')+RULES
  check=run(['nft','-c','-f','-'],input=payload)
  if check.returncode:raise RuntimeError(check.stderr[-500:])
  apply=run(['nft','-f','-'],input=payload)
  if apply.returncode:raise RuntimeError(apply.stderr[-500:])
  after=current();assert after is not None
  temp=EXPECTED.with_suffix('.tmp');temp.write_text(json.dumps(after,sort_keys=True));temp.replace(EXPECTED)
  ensure_reserved()
  print('APPLIED port=47800 tcp=blocked udp=blocked changed=1')

if __name__=='__main__':main()
